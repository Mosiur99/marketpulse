# Copy to .env for local runs. .env is ignored by git.
MARKETPULSE_DATABASE_URL=postgresql+asyncpg://marketpulse:marketpulse@localhost:5433/marketpulse
MARKETPULSE_LOG_LEVEL=INFO
# Where the local embedding model is stored (default: the system temp folder).
# MARKETPULSE_EMBEDDING_CACHE_DIR=~/.cache/fastembed

# AI agent: any OpenAI-compatible chat API. Groq's free tier by default (key from console.groq.com).
MARKETPULSE_LLM_API_KEY=
# MARKETPULSE_LLM_BASE_URL=https://api.groq.com/openai/v1
# MARKETPULSE_LLM_MODEL=openai/gpt-oss-120b

# Alerts and the daily summary. Without a Telegram bot they are written to the log.
# MARKETPULSE_TELEGRAM_BOT_TOKEN=      (from @BotFather)
# MARKETPULSE_TELEGRAM_CHAT_ID=        (your chat with the bot)
# MARKETPULSE_SUMMARY_TIME_UTC=08:00
# MARKETPULSE_ALERT_CHECK_SECONDS=60
